#!/data/data/com.termux/files/usr/bin/bash
# Сохраняет содержимое буфера обмена в файл.
# Использование: clip2file.sh [директория] [имя_файла]
# По умолчанию:  /storage/emulated/0/Settings/link.txt
# Требуется:     pkg install termux-api  +  приложение Termux:API

DIR="${1:-/storage/emulated/0/Settings}"
NAME="${2:-link.txt}"
DIR="${DIR%/}"
[ -z "$DIR" ] && DIR="/"
FILE="$DIR/$NAME"

log() { echo "[clip2file] $*" >&2; }

# Экранирование строки для su -c
q() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

# Команда от root: с таймаутом и без переменных окружения Termux
rsu() { timeout -k 1 30 su -c "unset LD_LIBRARY_PATH LD_PRELOAD; $1"; }

for c in termux-clipboard-get timeout; do
  command -v "$c" >/dev/null 2>&1 || { log "Не найдена команда $c (pkg install termux-api coreutils)"; exit 1; }
done

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

# Чтение буфера с таймаутом, чтобы скрипт не мог повиснуть навсегда
read_clip() { timeout -k 1 5 termux-clipboard-get > "$TMP" 2>/dev/null; }

log "1/3 Читаю буфер обмена..."
read_clip

if [ ! -s "$TMP" ]; then
  # Android 10+: фоновым приложениям буфер не отдаётся.
  # Выводим Termux на передний план через root и пробуем ещё раз.
  log "Буфер пуст или нет ответа от Termux:API. Вывожу Termux на передний план и повторяю..."
  rsu "am start -n com.termux/.app.TermuxActivity" >/dev/null 2>&1
  sleep 1
  read_clip
fi

if [ ! -s "$TMP" ]; then
  log "Не удалось прочитать буфер обмена."
  log "Проверьте: установлено ли приложение Termux:API, запускали ли вы его хотя бы раз, отключена ли для него оптимизация батареи."
  exit 1
fi

log "2/3 Записываю в $FILE ..."
if mkdir -p "$DIR" 2>/dev/null && cp "$TMP" "$FILE" 2>/dev/null; then
  :
else
  log "3/3 Нет прав на запись, пишу через root (если появится запрос root — разрешите)..."
  rsu "mkdir -p $(q "$DIR") && cp $(q "$TMP") $(q "$FILE") && chmod 644 $(q "$FILE")" \
    || { log "Не удалось создать файл: $FILE"; exit 1; }
fi

echo "Готово: $FILE ($(wc -c < "$TMP") байт)"
