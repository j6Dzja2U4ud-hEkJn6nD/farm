#!/data/data/com.termux/files/usr/bin/bash
# Сохраняет содержимое буфера обмена в файл.
# Использование: clip2file.sh [директория] [имя_файла]
# По умолчанию:  /storage/emulated/0/Settings/link.txt
# Способ 1 (root): service call clipboard  — нужны su и python3
# Способ 2 (запасной): termux-clipboard-get — нужны termux-api и Termux:API
# Переменная CLIP_CODES задаёт коды транзакции для getPrimaryClip (по умолчанию "2 3")

DIR="${1:-/storage/emulated/0/Settings}"
NAME="${2:-link.txt}"
DIR="${DIR%/}"
[ -z "$DIR" ] && DIR="/"
FILE="$DIR/$NAME"
CLIP_CODES="${CLIP_CODES:-2 3}"

log() { echo "[clip2file] $*" >&2; }

# Экранирование строки для su -c
q() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

# Команда от root: с таймаутом и без переменных окружения Termux
rsu() { timeout -k 1 30 su -c "unset LD_LIBRARY_PATH LD_PRELOAD; $1"; }

command -v timeout >/dev/null 2>&1 || { log "Не найдена команда timeout (pkg install coreutils)"; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

# Разбор дампа Parcel: достаёт текст из UTF-16 строк
PARSER=$(cat <<'PY'
import re, struct, sys

words = []
for line in sys.stdin.read().splitlines():
    m = re.match(r"\s*0x[0-9a-fA-F]+:\s+((?:[0-9a-fA-F]{8}\s*)+)", line)
    if m:
        words += m.group(1).split()

# Первое слово — код исключения; 0 = всё хорошо
if not words or int(words[0], 16) != 0:
    sys.exit(1)

data = b"".join(struct.pack("<I", int(w, 16)) for w in words)
n = len(data)
cands = []
i = 0
while i + 4 <= n:
    ln = struct.unpack_from("<i", data, i)[0]
    end = i + 4 + ln * 2
    if 0 < ln <= (1 << 20) and end + 2 <= n and data[end:end + 2] == b"\0\0":
        try:
            s = data[i + 4:end].decode("utf-16-le")
        except UnicodeDecodeError:
            i += 4
            continue
        if all(c >= " " or c in "\n\r\t" for c in s):
            cands.append(s)
            i += 4 + ((ln * 2 + 2 + 3) // 4) * 4
            continue
    i += 4

mime = re.compile(r"^[a-z]+/[\w.+*-]+$")
meta = re.compile(r"^android\.[\w.]+$")
last_mime = max((k for k, c in enumerate(cands) if mime.match(c)), default=-1)
rest = [c for c in cands[last_mime + 1:] if not meta.match(c)]
if not rest:
    sys.exit(1)
sys.stdout.buffer.write(rest[0].encode("utf-8"))
PY
)

# Способ 1: напрямую через root
read_clip_root() {
  command -v su >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1 || return 1
  local code out
  for code in $CLIP_CODES; do
    out="$(rsu "service call clipboard $code s16 com.android.shell i32 0" 2>/dev/null)" || continue
    printf '%s\n' "$out" | python3 -c "$PARSER" > "$TMP" 2>/dev/null
    [ -s "$TMP" ] && return 0
  done
  : > "$TMP"
  return 1
}

# Способ 2: через Termux:API
read_clip_api() {
  command -v termux-clipboard-get >/dev/null 2>&1 || return 1
  timeout -k 1 5 termux-clipboard-get > "$TMP" 2>/dev/null
  [ -s "$TMP" ] && return 0
  # Android 10+: фоновым приложениям буфер не отдаётся.
  # Выводим Termux на передний план через root и пробуем ещё раз.
  log "Нет ответа от Termux:API. Вывожу Termux на передний план и повторяю..."
  rsu "am start -n com.termux/.app.TermuxActivity" >/dev/null 2>&1
  sleep 1
  timeout -k 1 5 termux-clipboard-get > "$TMP" 2>/dev/null
  [ -s "$TMP" ]
}

log "1/2 Читаю буфер обмена..."
if read_clip_root; then
  log "Прочитано через root (service call)."
elif read_clip_api; then
  log "Прочитано через Termux:API."
else
  log "Не удалось прочитать буфер обмена."
  log "Root-способ: нужны su и python3, а код транзакции зависит от версии Android (CLIP_CODES)."
  log "Запасной способ: нужны termux-api и приложение Termux:API."
  exit 1
fi

log "2/2 Записываю в $FILE ..."
if mkdir -p "$DIR" 2>/dev/null && cp "$TMP" "$FILE" 2>/dev/null; then
  :
else
  log "Нет прав на запись, пишу через root (если появится запрос root — разрешите)..."
  rsu "mkdir -p $(q "$DIR") && cp $(q "$TMP") $(q "$FILE") && chmod 644 $(q "$FILE")" \
    || { log "Не удалось создать файл: $FILE"; exit 1; }
fi

echo "Готово: $FILE ($(wc -c < "$TMP") байт)"
