#!/data/data/com.termux/files/usr/bin/bash

DIR="/storage/emulated/0/Settings"
FILE="$DIR/link.txt"

PATTERN='https://auth\.platorelay\.com[^[:space:]]*'
TIMEOUT=30   # сколько всего ждать, сек
INTERVAL=5   # как часто проверять, сек
OPEN_EVERY_CHECK=1   # 1 = выводить Termux на экран перед каждой проверкой, 0 = только один раз в начале

# выводит Termux на передний план (через root, чтобы Android не заблокировал запуск из фона)
open_termux() {
    su -c "am start -n com.termux/com.termux.app.TermuxActivity" >/dev/null 2>&1 \
        || am start -n com.termux/com.termux.app.TermuxActivity >/dev/null 2>&1
    sleep 1   # даём окну время появиться, иначе буфер прочитается пустым
}

start=$(date +%s)
attempt=1
link=""

open_termux

while true; do
    clip=$(timeout 10 termux-clipboard-get 2>/dev/null)
    link=$(printf '%s' "$clip" | grep -oiE "$PATTERN" | head -n1)

    if [ -n "$link" ]; then
        break
    fi

    remaining=$(( TIMEOUT - ($(date +%s) - start) ))
    if [ "$remaining" -le 0 ]; then
        echo "За ${TIMEOUT} сек ссылка https://auth.platorelay.com... в буфере так и не появилась"
        exit 1
    fi

    echo "[$attempt] Нужной ссылки в буфере нет, жду... (осталось ~${remaining} сек)"
    attempt=$((attempt + 1))

    if [ "$remaining" -lt "$INTERVAL" ]; then
        sleep "$remaining"
    else
        sleep "$INTERVAL"
    fi

    if [ "$OPEN_EVERY_CHECK" = "1" ]; then
        open_termux
    fi
done

# запись через root; текст передаётся через stdin
if printf '%s' "$link" | su -c "mkdir -p '$DIR' && cat > '$FILE' && chmod 666 '$FILE'"; then
    echo "Сохранено в $FILE:"
    echo "$link"
else
    echo "Ошибка записи файла" >&2
    exit 1
fi
